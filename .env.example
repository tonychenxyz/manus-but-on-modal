# Anthropic API
ANTHROPIC_API_KEY=sk-ant-...

# GitHub (for worker sandbox repo access)
GITHUB_TOKEN=ghp_...

# Agent Home Settings
AGENT_HOME_JWT_SECRET=your-secret-key-here
AGENT_HOME_ORCHESTRATOR_MODEL=claude-sonnet-4-20250514
AGENT_HOME_WORKER_MODEL=claude-sonnet-4-20250514

# Google OAuth (for webapp auth)
AGENT_HOME_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
AGENT_HOME_GOOGLE_CLIENT_SECRET=your-client-secret
AGENT_HOME_ALLOWED_EMAILS=your@email.com,another@email.com

# Webapp Settings
WEBAPP_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
WEBAPP_GOOGLE_CLIENT_SECRET=your-client-secret
WEBAPP_GOOGLE_REDIRECT_URI=http://localhost:8000/auth/callback
WEBAPP_ALLOWED_EMAILS=your@email.com
WEBAPP_JWT_SECRET=your-webapp-secret
WEBAPP_FRONTEND_URL=http://localhost:3000
